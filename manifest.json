{
    "$schema": "https://raw.githubusercontent.com/BetterNCM/BetterNCM-Plugins/refs/heads/master/manifest-schema.json",
    "manifest_version": 1,
    "name": "AdvancedPlayBar",
    "slug": "advanced-playbar",
    "version": "1.0.0",
    "author": "Fina",
    "author_link": "https://github.com/FinaFina233",
    "description": "播放栏增强：透明/毛玻璃播放栏 + 进度条悬停动效 + 全局主题色自定义（PS 风格取色器）。",
    "preview": "preview.jpg",
    "type": "extension",
    "betterncm_version": ">=1.0.0",
    "ncm3-compatible": true,
    "ncm-version-req": "> 2.10.2",
    "require_restart": false,
    "loadAfter": ["BGEnhanced"],
    "startup_script": "startup_script.js",
    "injects": {
        "Main": [
            {
                "file": "main.js"
            }
        ]
    }
}
